{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anc-uav.invalid/schemas/content-pack-v1.json",
  "title": "ANC UAV Agency Content Pack v1",
  "description": "Offline documents and plain-text reference records only. Imported packs are always treated as unverified by the app.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "name",
    "issuer",
    "jurisdiction",
    "version",
    "sourceNote",
    "rightsSummary",
    "documents",
    "rules",
    "checklists"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "issuer": { "type": "string", "minLength": 1, "maxLength": 300 },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "region"],
      "properties": {
        "country": { "type": "string", "minLength": 1, "maxLength": 100 },
        "region": { "type": "string", "minLength": 1, "maxLength": 150 },
        "area": { "type": "string", "maxLength": 200 }
      }
    },
    "version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "sourceNote": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "rightsSummary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "documents": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "source", "version", "category", "sections"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "title": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "source": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "version": { "type": "string", "minLength": 1, "maxLength": 100 },
          "category": { "enum": ["quick-reference", "manual", "policy"] },
          "sections": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["heading", "body"],
              "properties": {
                "heading": { "type": "string", "minLength": 1, "maxLength": 300 },
                "body": { "type": "string", "minLength": 1, "maxLength": 100000 }
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "sourceDocumentId", "sourceReference", "statement"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "title": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "sourceDocumentId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "sourceReference": { "type": "string", "minLength": 1, "maxLength": 500 },
          "statement": { "type": "string", "minLength": 1, "maxLength": 10000 }
        }
      }
    },
    "checklists": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "sourceDocumentId", "items"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "title": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "sourceDocumentId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "items": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "sourceReference"],
              "properties": {
                "id": { "type": "string", "minLength": 1, "maxLength": 100 },
                "label": { "type": "string", "minLength": 1, "maxLength": 1000 },
                "sourceReference": { "type": "string", "minLength": 1, "maxLength": 500 }
              }
            }
          }
        }
      }
    }
  }
}
